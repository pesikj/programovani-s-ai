# Vymyšlené ukázkové údaje. Před zveřejněním vygenerujte vlastní heslo a klíč.
POSTGRES_DB=webovka
POSTGRES_USER=webovka
POSTGRES_PASSWORD=ukazkove-heslo-zmente-pred-nasazenim
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=ukazkovy-klic-zmente-pred-nasazenim-1234567890-abcdefghijk
DJANGO_DEBUG=False
